# New code: normalise to LF.
* text=auto eol=lf

# Audit deliverables and audit tooling are evidence: store byte-for-byte
# (CSV files carry a UTF-8 BOM; some scripts have CRLF line endings).
docs/audit/** -text
scripts/wordpress-audit/** -text

# Windows-only scripts keep CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.heic binary
*.pdf binary
*.woff binary
*.woff2 binary
