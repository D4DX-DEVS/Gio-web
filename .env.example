# GIO Kerala: environment variable NAMES only. Never put real values in this file.
#
# Where real values go:
#   - Local Worker runtime (next dev / opennextjs-cloudflare preview): apps/web/.dev.vars
#     (copy this file there and fill in; .dev.vars is git-ignored)
#   - Staging / production Worker: `wrangler secret put <NAME> --env <env>` (never in wrangler.jsonc)
#   - Wrangler / drizzle-kit / migration CLI on the developer machine: shell environment only
#
# Non-secret IDs (D1 database_id, R2 bucket names, account ID) belong in wrangler.jsonc, not here.

# --- Next.js / OpenNext ------------------------------------------------------
# Selects which .env.<NEXTJS_ENV> file OpenNext loads (development | production)
NEXTJS_ENV=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_MEDIA_BASE_URL=

# --- Better Auth (admin login) -----------------------------------------------
# Generate locally with: npx @better-auth/cli secret   (32+ random bytes)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# --- Admin panel login --------------------------------------------------------
# The only credentials that can sign in to /admin; there are no database accounts.
# Password: at least 12 characters. Changing either value signs out every admin session.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Display name in the admin sidebar (optional)
ADMIN_NAME=
# Base32 TOTP secret for the authenticator app. Required in production builds; optional in
# `next dev`. Generate with: node apps/web/scripts/generate-totp-secret.mjs
ADMIN_TOTP_SECRET=

# --- Cloudflare Access in front of /admin (JWT verification in the Worker) ---
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# --- Cloudflare Turnstile (contact form) -------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Contact form email notifications ----------------------------------------
# Provider pending (Resend or Cloudflare Email); recipient pending client decision C9
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_NOTIFY_TO=

# --- Privacy -----------------------------------------------------------------
# Salt for hashing visitor IPs in contact_submissions / audit_log
IP_HASH_SALT=

# --- Instagram feed (pending client decision C11) ----------------------------
INSTAGRAM_ACCESS_TOKEN=

# --- Error reporting (optional) ----------------------------------------------
SENTRY_DSN=

# =============================================================================
# Developer machine only. NOT for .dev.vars, NOT uploaded as Worker secrets.
# =============================================================================

# Wrangler / drizzle-kit (d1-http driver) against remote staging. Scoped API token:
# Workers Scripts, D1, R2 edit on the staging account only. No DNS permissions.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=

# Migration CLI: R2 S3-compatible credentials (bucket-scoped, staging buckets only)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=
R2_PRIVATE_BUCKET=

# Migration CLI: client-supplied sources (local paths outside the repo; phase 6)
WP_SQL_DUMP_PATH=
WP_WXR_PATH=
WP_UPLOADS_ZIP_PATH=
# Throwaway local MariaDB used to read the dump (phase 6)
WP_MARIADB_URL=
MIGRATE_TARGET=
